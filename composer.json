{
    "name": "ticka/module",
    "description": "Ticka sample module with deterministic PHPUnit CI",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.0.30"
    },
    "require-dev": {
        "phpunit/phpunit": "9.6.35"
    },
    "autoload": {
        "psr-4": {
            "Ticka\\": "src/Ticka/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ticka\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --configuration phpunit.xml",
        "test:ci": "vendor/bin/phpunit --configuration phpunit.xml --log-junit build/logs/junit.xml --testdox-html build/reports/testdox.html",
        "test:coverage": "vendor/bin/phpunit --configuration phpunit.xml --log-junit build/logs/junit.xml --coverage-clover build/logs/clover.xml --coverage-html build/coverage --testdox-html build/reports/testdox.html"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.0.30"
        }
    }
}
